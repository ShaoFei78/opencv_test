{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件 (OpenCV)",
            "command": "C:\\Program Files\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-I",
                "D:\\Program Files\\OpenCV4.11_mingw13.1.0\\include",
                "${file}",
                "-L",
                "D:\\Program Files\\OpenCV4.11_mingw13.1.0\\x64\\mingw\\lib",
                "-lopencv_world4110",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译器: g++ (MinGW 13.1.0) + OpenCV 4.11.0 (MinGW 版)"
        },
        {
            "label": "运行活动文件 (不调试)",
            "type": "shell",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "C/C++: g++ 生成活动文件 (OpenCV)",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
